  "exceptions": {
    "stove_not_ready": {
      "message": "The stove is not ready yet: the bridge has just started or is not linked to the stove. Nothing was sent; try again in a few seconds."
    },
    "name_refused": {
      "message": "The bridge does not answer under the name {host}. Open its page by its IP address (http://{ip}) and add this name in the Bridge tab, section Access, or set up the integration again with the IP address."
    },
    "command_failed": {
      "message": "The command did not reach the bridge at {host}: {error}"
    },
    "schedule_end_before_start": {
      "message": "Slot {slot}: the end ({end}) is before the start ({start}). Nothing was sent to the stove."
    },
    "schedule_not_chosen": {
      "message": "No schedule is chosen. Create one (Settings, Devices & services, Helpers, Schedule), then choose it in the options of the Open Firenet integration."
    },
    "schedule_not_found": {
      "message": "The schedule {entity} cannot be read. Check that it still exists, then choose it again in the options of the integration."
    },
    "schedule_too_many_slots": {
      "message": "The stove takes two time ranges per day, and {weekday} has {count} in this schedule. Nothing was sent to the stove."
    }
