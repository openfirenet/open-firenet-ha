      "message": "Der Ofen ist noch nicht bereit: Der Stick wurde gerade gestartet oder ist nicht mit dem Ofen verbunden. Es wurde nichts gesendet; versuchen Sie es in einigen Sekunden erneut."
    },
    "name_refused": {
      "message": "Der Stick antwortet nicht unter dem Namen {host}. Öffnen Sie seine Seite über die IP-Adresse (http://{ip}) und tragen Sie diesen Namen im Tab Stick, Abschnitt Zugriff, ein, oder richten Sie die Integration mit der IP-Adresse neu ein."
    },
    "command_failed": {
      "message": "Der Befehl hat den Stick unter {host} nicht erreicht: {error}"
    },
    "schedule_end_before_start": {
      "message": "Zeitfenster {slot}: Das Ende ({end}) liegt vor dem Beginn ({start}). Es wurde nichts an den Ofen gesendet."
    },
    "schedule_not_chosen": {
      "message": "Es ist kein Zeitplan ausgewählt. Legen Sie einen an (Einstellungen, Geräte & Dienste, Helfer, Zeitplan) und wählen Sie ihn dann in den Optionen der Open-Firenet-Integration aus."
    },
    "schedule_not_found": {
      "message": "Der Zeitplan {entity} kann nicht gelesen werden. Prüfen Sie, ob er noch existiert, und wählen Sie ihn dann erneut in den Optionen der Integration aus."
    },
    "schedule_too_many_slots": {
      "message": "Der Ofen akzeptiert zwei Zeitfenster pro Tag, dieser Zeitplan hat für {weekday} {count}. Es wurde nichts an den Ofen gesendet."
